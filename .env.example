# ==========================================
# Root Environment Configuration Template
# Copy this file to .env for local setup
# NEVER commit real credentials to Git!
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017/college_erp_dev
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/college_erp_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp_dev

# JWT Authentication Secrets
# Generate secure strings in production (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Frontend Environment (Vite exposes vars prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api
